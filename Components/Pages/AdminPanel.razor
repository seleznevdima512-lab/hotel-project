@page "/admin"
@rendermode InteractiveServer
@using hotel.Data
@using hotel.Models
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@inject NavigationManager Nav

<h3>Управление пользователями</h3>

@if (!isAdmin)
{
    <div class="alert alert-danger">Доступ запрещён.</div>
    <button class="btn btn-primary" @onclick="GoToLogin">На страницу входа</button>
}
else
{
    @if (message != null)
    {
         <div class="alert alert-info">@message</div>
    }

    <h5>@(editId == null ? "Добавить" : "Редактировать")</h5>
    <div class="row mb-3">
        <div class="col"><input class="form-control" placeholder="Логин" @bind="editLogin" disabled="@(editId != null)" /></div>
        <div class="col"><input class="form-control" placeholder="Пароль" @bind="editPassword" /></div>
        <div class="col">
            <select class="form-select" @bind="editRole">
                <option value="User">Пользователь</option>
                <option value="Admin">Администратор</option>
            </select>
        </div>
        <div class="col">
            <button class="btn btn-success" @onclick="SaveUser">@(editId == null ? "Добавить" : "Сохранить")</button>
            @if (editId != null)
            {
                <button class="btn btn-secondary" @onclick="CancelEdit">Отмена</button>
            }
        </div>
    </div>

    <table class="table table-striped">
        <thead><tr><th>ID</th><th>Логин</th><th>Роль</th><th>Статус</th><th>Действия</th></tr></thead>
        <tbody>
            @foreach (var u in users)
            {
                <tr>
                    <td>@u.UserId</td>
                    <td>@u.Login</td>
                    <td>@u.Role</td>
                    <td>@(u.IsBlocked != 0 ? "Заблокирован" : "Активен")</td>
                    <td>
                        <button class="btn btn-sm btn-primary" @onclick="() => StartEdit(u)">Изменить</button>
                        @if (u.IsBlocked != 0)
                        {
                            <button class="btn btn-sm btn-success" @onclick="() => Unblock(u)">Разблокировать</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <button class="btn btn-secondary" @onclick="Logout">Выйти</button>
}

@code {
    [SupplyParameterFromQuery] public string? Login { get; set; }

    private bool isAdmin;
    private List<User> users = new();
    private string? message;

    private int? editId;
    private string? editLogin, editPassword;
    private string editRole = "User";

    protected override async Task OnInitializedAsync()
    {
        var me = await Db.Users.FirstOrDefaultAsync(u => u.Login == Login);
        isAdmin = me?.Role == "Admin" && me.IsBlocked == 0;
        if (isAdmin) users = await Db.Users.ToListAsync();
    }

    private void GoToLogin() => Nav.NavigateTo("/login");
    private void Logout() => Nav.NavigateTo("/login", forceLoad: true);

    private void StartEdit(User u)
    {
        editId = u.UserId;
        editLogin = u.Login;
        editPassword = u.PasswordHash;
        editRole = u.Role;
        message = null;
    }

    private void CancelEdit()
    {
        editId = null;
        editLogin = editPassword = null;
        editRole = "User";
    }

    private async Task SaveUser()
    {
        message = null;
        if (string.IsNullOrWhiteSpace(editLogin) || string.IsNullOrWhiteSpace(editPassword))
        {
            message = "Заполните логин и пароль.";
            return;
        }

        if (editId == null) 
        {
            if (await Db.Users.AnyAsync(u => u.Login == editLogin))
            {
                message = "Такой логин уже существует.";
                return;
            }
            Db.Users.Add(new User { Login = editLogin, PasswordHash = editPassword, Role = editRole });
            message = "Пользователь добавлен.";
        }
        else 
        {
            var u = await Db.Users.FindAsync(editId);
            if (u != null)
            {
                u.PasswordHash = editPassword;
                u.Role = editRole;
            }
            message = "Данные обновлены.";
        }

        await Db.SaveChangesAsync();
        users = await Db.Users.ToListAsync();
        CancelEdit();
    }

    private async Task Unblock(User u)
    {
        u.IsBlocked = 0;
        u.FailedAttempts = 0;
        await Db.SaveChangesAsync();
        users = await Db.Users.ToListAsync();
        message = $"Пользователь {u.Login} разблокирован.";
    }
}