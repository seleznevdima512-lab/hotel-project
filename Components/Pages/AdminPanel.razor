@page "/admin"
@rendermode InteractiveServer
@using hotel.Data
@using hotel.Models
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@inject NavigationManager Navigation

<h3>Управление пользователями</h3>

@if (!isAuthorized)
{
    <div class="alert alert-danger">Доступ запрещён. Войдите как администратор.</div>
    <button class="btn btn-primary" @onclick="GoToLogin">На страницу входа</button>
}
else
{
    @if (message != null)
    {
        <div class="alert alert-info">@message</div>
    }

    <h5>Добавить пользователя</h5>
    <div class="row mb-3">
        <div class="col"><input class="form-control" placeholder="Логин" @bind="newLogin" /></div>
        <div class="col"><input class="form-control" placeholder="Пароль" @bind="newPassword" /></div>
        <div class="col">
            <select class="form-select" @bind="newRole">
                <option value="User">Пользователь</option>
                <option value="Admin">Администратор</option>
            </select>
        </div>
        <div class="col"><button class="btn btn-success" @onclick="AddUser">Добавить</button></div>
    </div>

    <h5>Список пользователей</h5>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Логин</th>
                <th>Роль</th>
                <th>Статус</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var u in users)
            {
                <tr>
                    <td>@u.UserId</td>
                    <td>@u.Login</td>
                    <td>@u.Role</td>
                    <td>
                        @if (u.IsBlocked != 0)
                        {
                            <span class="text-danger">Заблокирован</span>
                        }
                        else
                        {
                            <span class="text-success">Активен</span>
                        }
                    </td>
                    <td>
                        @if (u.IsBlocked != 0)
                        {
                            <button class="btn btn-sm btn-success" @onclick="() => Unblock(u)">Разблокировать</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <button class="btn btn-secondary" @onclick="Logout">Выйти</button>
}

@code {
    [SupplyParameterFromQuery]
    public string? Login { get; set; }

    private bool isAuthorized = false;
    private List<User> users = new();
    private string? message;
    private string? newLogin;
    private string? newPassword;
    private string newRole = "User";

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrEmpty(Login))
        {
            isAuthorized = false;
            return;
        }

        var user = await Db.Users.FirstOrDefaultAsync(u => u.Login == Login);
        isAuthorized = user != null && user.Role == "Admin" && user.IsBlocked == 0;

        if (isAuthorized)
            users = await Db.Users.ToListAsync();
    }

    private void GoToLogin()
    {
        Navigation.NavigateTo("/login");
    }

    private async Task AddUser()
    {
        message = null;
        if (string.IsNullOrWhiteSpace(newLogin) || string.IsNullOrWhiteSpace(newPassword))
        {
            message = "Заполните логин и пароль.";
            return;
        }

        if (await Db.Users.AnyAsync(u => u.Login == newLogin))
        {
            message = $"Пользователь с логином «{newLogin}» уже существует.";
            return;
        }

        var user = new User
            {
                Login = newLogin,
                PasswordHash = newPassword,
                Role = newRole,
                IsBlocked = 0,
                FailedAttempts = 0
            };
        Db.Users.Add(user);
        await Db.SaveChangesAsync();

        message = $"Пользователь {newLogin} добавлен.";
        newLogin = null;
        newPassword = null;
        newRole = "User";
        users = await Db.Users.ToListAsync();
    }

    private async Task Unblock(User user)
    {
        user.IsBlocked = 0;
        user.FailedAttempts = 0;
        Db.Users.Update(user);
        await Db.SaveChangesAsync();
        message = $"Пользователь {user.Login} разблокирован.";
        users = await Db.Users.ToListAsync();
    }

    private void Logout()
    {
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}